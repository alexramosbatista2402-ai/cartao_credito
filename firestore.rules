rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada pessoa só enxerga e altera os próprios lançamentos.
    match /users/{uid}/gastos/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.v is number && request.resource.data.v > 0
        && request.resource.data.d is string
        && request.resource.data.cat in ['Combustível','Supermercado','Insumos','Outros'];
    }

    // Todo o resto é bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
